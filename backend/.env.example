# Local development (copy to .env)
NODE_ENV=production
PORT=4000
MONGO_URL=mongodb://localhost:27017/Blog
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=<your-upstash-token>
CACHE_TTL=3600

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Production on Render — example values:
# PORT is set automatically by Render (do not hardcode in dashboard)
# NODE_ENV=production (set automatically by Render)
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Blog?retryWrites=true&w=majority
# JWT_SECRET=<long-random-secret>
# CLIENT_URL=https://your-app.vercel.app
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# REDIS_TOKEN=<your-upstash-token>
# CLOUDINARY_CLOUD_NAME=<your-cloud-name>
# CLOUDINARY_API_KEY=<your-api-key>
# CLOUDINARY_API_SECRET=<your-api-secret>
