# Local development (copy to .env)
PORT=4000
MONGO_URL=mongodb://localhost:27017/Blog
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Production on Render — example values:
# PORT is set automatically by Render (do not hardcode in dashboard)
# NODE_ENV=production (set automatically by Render)
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Blog?retryWrites=true&w=majority
# JWT_SECRET=<long-random-secret>
# CLIENT_URL=https://your-app.vercel.app
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
